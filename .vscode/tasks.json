{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SASLite: Run current SAS file",
      "type": "process",
      "command": "${workspaceFolder}/scripts/run-saslite",
      "args": [
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
